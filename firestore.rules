rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public email links: anyone with report ID can read that one document only.
    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /locations_master/{docId} {
      allow read, write: if true;
    }

    match /zonal_centers/{docId} {
      allow read, write: if true;
    }

    match /categories_master/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /_automation_mail_log/{docId} {
      allow read, write: if false;
    }
  }
}
